    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const strategy = $('Strategy Engine').item.json;\nconst limits = $('Get Capital Limits').item.json;\nconst price = Number(strategy.price);\nconst tradingCapital = Number(limits.trading_capital);\nconst configuredMax = Number(limits.max_position_value);\nconst sizingLimit = Math.min(tradingCapital, configuredMax);\n\nif (!Number.isFinite(price) || price <= 0) {\n  throw new Error('Invalid stock price');\n}\nif (!Number.isFinite(sizingLimit) || sizingLimit <= 0) {\n  throw new Error('No trading capital available');\n}\n\nconst quantity = Math.floor((sizingLimit / price) * 10000) / 10000;\nconst positionValue = Number((quantity * price).toFixed(2));\nreturn {\n  json: {\n    ...strategy,\n    trading_capital: tradingCapital,\n    position_value: positionValue,\n    quantity,\n    sizing_limit: sizingLimit\n  }\n};"
      },
