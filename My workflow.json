    {
      "parameters": {
        "jsCode": "\nconst price = Number($json.price);\nconst rawChange = $json.change_percent;\nconst hasChange = rawChange !== null && rawChange !== undefined && String(rawChange).trim() !== \"\";\nconst changePercent = hasChange\n  ? Number(String(rawChange).replace(\"%\", \"\").trim())\n  : Number.NaN;\n\nlet signal = \"HOLD\";\nif (Number.isFinite(changePercent)) {\n  if (changePercent >= 1) {\n    signal = \"BUY_CANDIDATE\";\n  } else if (changePercent <= -1) {\n    signal = \"SELL_CANDIDATE\";\n  }\n}\n\nreturn {\n  json: {\n    symbol: $json.symbol ?? \"IBM\",\n    price,\n    change_percent: Number.isFinite(changePercent) ? changePercent : null,\n    signal,\n    mode: \"PAPER\",\n    note: \"Demo rule only; not a validated trading strategy.\"\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        -112
      ],
      "id": "7563da96-a686-4f8b-954e-89b7fd5bbb4d",
      "name": "Strategy Engine"
    },
